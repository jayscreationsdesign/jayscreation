# ===========================================
# VARIABLES D'ENVIRONNEMENT POUR SUPABASE EDGE FUNCTIONS
# ===========================================

# Configuration IONOS Email Marketing
IONOS_EMAIL_HOST=smtp.ionos.de
IONOS_EMAIL_PORT=587
IONOS_EMAIL_SECURE=false
IONOS_EMAIL_USER=newsletter@jayscreationsdesign.fr
IONOS_EMAIL_PASS=votre_mot_de_passe_ionos_email_marketing

# Configuration Resend (alternative recommandée)
RESEND_API_KEY=re_votre_cle_api_resend

# URL de votre site pour les liens dans les emails
SITE_URL=https://www.jayscreationsdesign.fr

# Adresses emails de destination pour les tests
ADMIN_EMAIL=contact@jayscreationsdesign.fr
ORDER_EMAIL=commande@jayscreationsdesign.fr
TEST_EMAIL=contact@jayscreationsdesign.fr

# ===========================================
# INSTRUCTIONS DE CONFIGURATION
# ===========================================

# 1. Copiez ce fichier en .env dans le dossier supabase/functions/
# 2. Remplacez les valeurs par vos vraies identifiants IONOS
# 3. Si vous utilisez Resend, créez un compte sur resend.com
# 4. Déployez les Edge Functions avec supabase functions deploy
# 5. Testez l'envoi d'emails

# ===========================================
# OBTENIR LES IDENTIFIANTS IONOS EMAIL MARKETING
# ===========================================

# 1. Connectez-vous à votre espace IONOS
# 2. Allez dans "Email Marketing" > "Paramètres"
# 3. Créez un compte email : newsletter@jayscreationsdesign.fr
# 4. Allez dans "Paramètres SMTP" pour obtenir:
#    - Serveur SMTP: smtp.ionos.de
#    - Port: 587
#    - Nom d'utilisateur: newsletter@jayscreationsdesign.fr
#    - Mot de passe: généré depuis l'interface IONOS

# ===========================================
# ALTERNATIVE: UTILISER RESEND (RECOMMANDÉ)
# ===========================================

# Resend est plus simple et plus fiable pour les emails transactionnels
# 1. Créez un compte sur https://resend.com
# 2. Vérifiez votre domaine jayscreationsdesign.fr
# 3. Obtenez votre clé API (commence par re_)
# 4. Configurez RESEND_API_KEY ci-dessus
