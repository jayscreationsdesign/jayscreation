# ===========================================
# CONFIGURATION IONOS EMAIL MARKETING
# ===========================================

# Serveur SMTP Ionos
IONOS_SMTP_HOST=smtp.ionos.fr
IONOS_SMTP_PORT=587

# Identifiants email Ionos (REMPLACEZ AVEC VOS VALEURS)
IONOS_EMAIL_USER=contact@jayscreationsdesign.fr
IONOS_EMAIL_PASS=votre_mot_de_passe_ionos

# Adresses d'expéditeurs spécifiques
IONOS_TRANSACTIONAL_EMAIL=contact@jayscreationsdesign.fr
IONOS_ORDER_EMAIL=commande@jayscreationsdesign.fr
IONOS_ADMIN_EMAIL=contact@jayscreationsdesign.fr

# ===========================================
# CONFIGURATION SUPABASE
# ===========================================

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-supabase

# ===========================================
# CONFIGURATION STRIPE
# ===========================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# ===========================================
# INSTRUCTIONS
# ===========================================

# 1. Copiez ce fichier en .env.local
# 2. Remplissez vos vraies valeurs IONOS
# 3. Configurez les enregistrements DNS (voir documentation)
# 4. Testez l'envoi d'emails
