# ===========================================
# CONFIGURATION IONOS EMAIL MARKETING
# ===========================================

# Serveur SMTP Ionos
IONOS_SMTP_HOST=smtp.ionos.fr
IONOS_SMTP_PORT=587

# VOS IDENTIFIANTS IONOS (REMPLACEZ CES VALEURS)
IONOS_EMAIL_USER=contact@jayscreationsdesign.fr
IONOS_EMAIL_PASS=VOTRE_MOT_DE_PASSE_IONOS_ICI

# Adresses d'expéditeurs spécifiques
IONOS_TRANSACTIONAL_EMAIL=contact@jayscreationsdesign.fr
IONOS_ORDER_EMAIL=commande@jayscreationsdesign.fr
IONOS_ADMIN_EMAIL=contact@jayscreationsdesign.fr

# ===========================================
# CONFIGURATION SUPABASE (VOS VALEURS EXISTANTES)
# ===========================================

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-supabase

# ===========================================
# CONFIGURATION STRIPE (VOS VALEURS EXISTANTES)
# ===========================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# ===========================================
# CONFIGURATION TWILIO WHATSAPP (OPTIONNEL)
# ===========================================

# Identifiants Twilio pour les notifications WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+33749072861

# Note : Les notifications WhatsApp sont optionnelles.
# Si Twilio n'est pas configuré, le système fonctionnera sans WhatsApp.

# ===========================================
# CONFIGURATION BASE URL (IMPORTANT)
# ===========================================

# URL de votre site pour les emails
NEXT_PUBLIC_BASE_URL=https://www.jayscreationsdesign.fr

# ===========================================
# 🔧 INSTRUCTIONS IMPORTANTES
# ===========================================

# 1. REMPLACEZ SEULEMENT CES VALEURS :
#    - IONOS_EMAIL_PASS=votre_vrai_mot_de_passe_ionos
#    - NEXT_PUBLIC_SUPABASE_URL=votre_vraie_url_supabase
#    - SUPABASE_SERVICE_ROLE_KEY=votre_vraie_cle_supabase
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_vraie_cle_anon
#    - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=votre_vraie_cle_stripe
#    - STRIPE_SECRET_KEY=votre_vraie_cle_secrete_stripe

# 2. NE MODIFIEZ PAS LES VALEURS EMAIL :
#    - contact@jayscreationsdesign.fr (déjà configuré)
#    - commande@jayscreationsdesign.fr (à créer si besoin)

# 3. POUR TROUVER VOS IDENTIFIANTS IONOS :
#    - Connectez-vous à ionos.fr
#    - Allez dans "Email & Office"
#    - Cherchez "Configuration SMTP" ou "Paramètres email"
#    - Votre email : contact@jayscreationsdesign.fr
#    - Votre mot de passe : celui de votre boîte email Ionos

# 4. SÉCURITÉ :
#    - Ce fichier ne doit JAMAIS être partagé
#    - Il est déjà dans .gitignore
#    - Ne le committez jamais sur GitHub

